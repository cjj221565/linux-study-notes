env  
#环境变量文件
# docker-compose 在启动的时候，会自动读取这个文件，把里面的键值对导入，给 MySQL 容器使用。
# 特点：专门存放配置信息（密码、名称这类敏感 / 可变内容），不要写进 docker-compose.yml
MYSQL_ROOT_PASSWORD=Admin@123456
# MySQL 超级管理员 root 的密码 容器第一次初始化 MySQL 的时候，自动设置 root 账号密码
MYSQL_DATABASE=testdb
# 创建表testab 这样就不用 creat database testab
MYSQL_USER=testuser
# 自动新建一个普通数据库账号 不是root 权限小
MYSQL_PASSWORD=User@123456
# 普通数据库账号和密码
